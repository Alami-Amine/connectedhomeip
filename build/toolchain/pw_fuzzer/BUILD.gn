import("//build_overrides/build.gni")
import("//build_overrides/pigweed.gni")

import("${build_root}/config/compiler/compiler.gni")
import("${build_root}/toolchain/gcc_toolchain.gni")

declare_args() {
  # Build the FuzzTest targets in libFuzzer-compatibility mode (what OSS-Fuzz
  # drives) instead of FuzzTest's native engine. Always on under `oss_fuzz`; set
  # true locally to reproduce OSS-Fuzz or use libFuzzer corpus/merge/minimize.
  # Default: native run mode.
  chip_pw_fuzz_libfuzzer_compat = false

  # Build the local FuzzTest targets with UBSan in addition to the default ASan
  # (set by the `ubsan` build_examples modifier on a -pw-fuzztest target). Local
  # builds only; under OSS-Fuzz the engine drives sanitizers via $CFLAGS.
  chip_pw_fuzz_ubsan = false

  # Build the local FuzzTest targets with MemorySanitizer instead of the default
  # ASan (set by the `msan` build_examples modifier on a -pw-fuzztest target).
  # Requires an instrumented sysroot via msan_sysroot. Local builds only; under
  # OSS-Fuzz the engine drives sanitizers via $CFLAGS.
  chip_pw_fuzz_msan = false
}

assert(
    !chip_pw_fuzz_msan || msan_sysroot != "",
    "chip_pw_fuzz_msan=true requires msan_sysroot to be set. Build via " + "scripts/build/build_examples.py --target ...-pw-fuzztest-msan-clang, " + "or set SYSROOT_MSAN before `gn gen`.")

_use_libfuzzer_compat = oss_fuzz || chip_pw_fuzz_libfuzzer_compat

# Compiler used to resolve the libFuzzer runtime archive: $CXX under OSS-Fuzz,
# otherwise the clang++ this toolchain compiles with.
if (oss_fuzz) {
  _fuzztest_compiler = getenv("CXX")
} else {
  _fuzztest_compiler = "clang++"
}

# compatibility_mode.cc defines FuzzTestExternalEngineAdaptor only under
# FUZZTEST_COMPATIBILITY_MODE, so the define must reach the FuzzTest library,
# not just the harness.
config("fuzztest_compatibility_mode") {
  defines = [ "FUZZTEST_COMPATIBILITY_MODE=libfuzzer" ]
}

# FuzzTest keeps its own main (fuzztest_gtest_main) and calls
# LLVMFuzzerRunDriver, so link the libFuzzer runtime WITHOUT its main -- never
# plain -fsanitize=fuzzer / $LIB_FUZZING_ENGINE.
config("fuzztest_libfuzzer_engine") {
  ldflags = [ exec_script("print_file_name.py",
                          [
                            _fuzztest_compiler,
                            "libclang_rt.fuzzer_no_main.a",
                          ],
                          "trim string") ]
}

# Fuzzing-specific deltas over chip's UBSan config, which is_ubsan already
# applies.
config("fuzztest_ubsan") {
  cflags = [
    # make UB abort so FuzzTest records it as a crash (UBSan recovers by
    # default)
    "-fno-sanitize-recover=undefined",

    # defined unsigned wraps, not UB -- fuzzing noise on first-party code
    "-fno-sanitize=unsigned-integer-overflow",
    "-fno-sanitize=unsigned-shift-base",
  ]
  ldflags = [ "-fsanitize=undefined" ]
}

# Coverage feedback for MSAN builds; with ASan, chip's sanitize_address config
# carries the same -fsanitize-coverage flags.
config("fuzztest_coverage") {
  cflags = [ "-fsanitize-coverage=inline-8bit-counters,trace-cmp" ]
}

# FuzzTest links the libFuzzer runtime archive ahead of the objects that use it,
# which only lld resolves. chip applies target_ldflags (where OSS-Fuzz passes
# -fuse-ld=lld) to the default toolchain only, so select lld here.
config("fuzztest_lld") {
  ldflags = [ "-fuse-ld=lld" ]
}

# Toolchain for FuzzTest binaries: chip's clang host toolchain with chip's own
# sanitizer, fuzzing and coverage configs. //third_party/fuzztest-gn builds
# FuzzTest itself.
gcc_toolchain("chip_pw_fuzztest") {
  # Under OSS-Fuzz, use the compiler OSS-Fuzz provides ($CC/$CXX) so the
  # instrumentation it injects via $CFLAGS/$CXXFLAGS (chip's oss_fuzz config)
  # matches the runtime we link.
  if (oss_fuzz) {
    cc = getenv("CC")
    cxx = getenv("CXX")
  }

  toolchain_args = {
    current_os = host_os
    current_cpu = host_cpu
    is_clang = true

    chip_fuzztest_dir = "//third_party/fuzztest"
    chip_abseil_cpp_dir = "//third_party/abseil-cpp/src"

    # chip's test-support libraries use pw_unit_test; back it with the
    # GoogleTest that FuzzTest links so a binary holds a single copy.
    pw_unit_test_BACKEND = "$dir_pw_unit_test:googletest"
    dir_pw_third_party_googletest = ""
    pw_third_party_googletest_ALIAS =
        "//third_party/fuzztest-gn/googletest:googletest"
    chip_build_tests_googletest = true

    # the third_party abseil-cpp triggers warnings related to
    # [-Wformat-nonliteral]
    treat_warnings_as_errors = false

    default_configs_extra = [ "//build/toolchain/pw_fuzzer:fuzztest_lld" ]
    if (_use_libfuzzer_compat) {
      default_configs_extra += [
        "//build/toolchain/pw_fuzzer:fuzztest_compatibility_mode",
        "//build/toolchain/pw_fuzzer:fuzztest_libfuzzer_engine",
      ]
    }

    # Under OSS-Fuzz, $CFLAGS/$CXXFLAGS drive sanitizers and coverage through
    # chip's fuzzing_default -> oss_fuzz config.
    if (!oss_fuzz) {
      if (chip_pw_fuzz_msan) {
        is_msan = true
        default_configs_extra +=
            [ "//build/toolchain/pw_fuzzer:fuzztest_coverage" ]
      } else {
        is_asan = true
        if (chip_pw_fuzz_ubsan) {
          default_configs_extra +=
              [ "//build/toolchain/pw_fuzzer:fuzztest_ubsan" ]
        }
      }
    }
  }
}
