# GN build for Google FuzzTest, independent of Pigweed. fuzztest/ and
# abseil-cpp/ hold BUILD.gn files generated from the Bazel build (see
# import_bazel_to_gn.py); googletest/ and the .gni templates are maintained
# here. Built only in //build/toolchain/pw_fuzzer:chip_pw_fuzztest.

import("//build_overrides/build.gni")

import("${build_root}/config/compiler/compiler.gni")
import("//third_party/fuzztest-gn/fuzztest/fuzztest.gni")

# Applied to the FuzzTest and Abseil sources. Coverage-instrumenting them makes
# FuzzTest trace its own comparisons, which recurses without bound. Under
# OSS-Fuzz the instrumentation comes from $CFLAGS and is left as it is.
config("fuzztest_runtime") {
  if (!oss_fuzz) {
    cflags = [ "-fno-sanitize-coverage=inline-8bit-counters,trace-cmp" ]
  }
}

if (chip_fuzztest_dir != "") {
  source_set("asan_default_options") {
    sources = [ "asan_default_options.c" ]
  }

  # Everything a FuzzTest binary needs, including main().
  group("fuzztest") {
    public_deps = [
      ":asan_default_options",
      "//third_party/fuzztest-gn/fuzztest/fuzztest:fuzztest_core",
      "//third_party/fuzztest-gn/fuzztest/fuzztest:fuzztest_gtest_main",
    ]
  }
}
