# Bazel workspace that bazel_to_gn.py queries to generate the FuzzTest and
# Abseil BUILD.gn files. The versions here must match the submodules in
# third_party/fuzztest and third_party/abseil-cpp/src. Versions are the ones
# Pigweed used to generate the files at pigweed c14c119c5.

module(name = "chip_fuzztest_gn")

bazel_dep(name = "fuzztest", version = "20250214.0")
bazel_dep(name = "abseil-cpp", version = "20240116.1")
bazel_dep(name = "googletest", version = "1.16.0", repo_name = "com_google_googletest")
bazel_dep(name = "re2", version = "2024-07-02.bcr.1")
